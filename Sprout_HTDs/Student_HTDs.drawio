o 1-2-3-4-5.&lt;br&gt;Press EN or DE any time to change the language." style="text;html=1;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacing=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1140" y="118" width="290" height="49" as="geometry"/></mxCell><mxCell id="c57" value="plan 2:&lt;br&gt;do 2.1-2.2-2.3." style="text;html=1;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacing=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="429" y="281" width="98" height="34" as="geometry"/></mxCell><mxCell id="c58" value="plan 3:&lt;br&gt;do 3.1, then 3.2 and/or 3.3." style="text;html=1;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacing=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="903" y="281" width="165" height="34" as="geometry"/></mxCell><mxCell id="c59" value="plan 4:&lt;br&gt;do 4.1, then 4.2-4.6 for each mistake.&lt;br&gt;If the mistake is still not clear, do 4.3&lt;br&gt;or 4.4 before 4.6. 4.5 is optional; if voice&lt;br&gt;answers are off, type the answer instead." style="text;html=1;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacing=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1614" y="281" width="250" height="79" as="geometry"/></mxCell><mxCell id="c60" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="295" as="sourcePoint"/><mxPoint x="172" y="295" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c61" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2094" y="295" as="sourcePoint"/><mxPoint x="2226" y="295" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="S3_Answer_teacher_message" name="S3 Answer teacher message"><mxGraphModel grid="1" gridSize="10" guides="1" page="1" pageWidth="1160" pageHeight="519" background="#FFFFFF"><root><mxCel