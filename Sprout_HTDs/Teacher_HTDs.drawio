y" /></mxCell><mxCell id="c45" value="plan 2:&lt;br&gt;do 2.1. If the AI draft is&lt;br&gt;not right, do 2.2." style="text;html=1;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacing=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="350" y="311" width="141" height="49" as="geometry" /></mxCell><mxCell id="c46" value="plan 3:&lt;br&gt;do 3.1.&lt;br&gt;If the circle is on the wrong step, do 3.2.&lt;br&gt;If it should not be shown, do 3.3." style="text;html=1;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacing=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="745" y="311" width="232" height="64" as="geometry" /></mxCell><mxCell id="c47" value="plan 4:&lt;br&gt;do 4.1-4.2. Do 4.3 if you want&lt;br&gt;to add a personal message." style="text;html=1;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacing=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1219" y="311" width="177" height="49" as="geometry" /></mxCell><mxCell id="c48" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="325" as="sourcePoint" /><mxPoint x="172" y="325" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c49" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1462" y="325" as="sourcePoint" /><mxPoint x="1594" y="325" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>